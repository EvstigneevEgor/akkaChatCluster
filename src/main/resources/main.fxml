<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<HBox id="body" prefHeight="579.0" prefWidth="802.0" stylesheets="main.css" xmlns="http://javafx.com/javafx/17.0.2-ea"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.view.ControllerScala">
    <children>
        <VBox id="left-side" prefHeight="200.0" prefWidth="100.0">
            <children>
                <Label alignment="BOTTOM_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                       text="Введите свой никнейм:" VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets left="10.0" top="10.0"/>
                    </VBox.margin>
                </Label>
                <HBox prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <TextField fx:id="nick" alignment="BOTTOM_LEFT" maxHeight="1.7976931348623157E308"
                                   maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                            </HBox.margin>
                        </TextField>
                        <Button fx:id="login" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                                mnemonicParsing="false" text="Зайти">
                            <HBox.margin>
                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                            </HBox.margin>
                        </Button>
                    </children>
                </HBox>
                <ListView id="contacts" fx:id="contactList" prefHeight="579.0" prefWidth="57.0"
                          style="-fx-pref-width: 20%; -fx-min-width: 250;" VBox.vgrow="ALWAYS"/>
            </children>
        </VBox>
        <VBox alignment="TOP_CENTER" prefHeight="579.0" prefWidth="471.0" HBox.hgrow="ALWAYS">
            <children>
                <ListView fx:id="messageList" depthTest="ENABLE" prefHeight="430.0" prefWidth="552.0"
                          stylesheets="messages.css" VBox.vgrow="ALWAYS">
                    <opaqueInsets>
                        <Insets/>
                    </opaqueInsets>
                </ListView>
                <HBox alignment="BOTTOM_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                      prefHeight="0.0" prefWidth="552.0" VBox.vgrow="ALWAYS">
                    <children>
                        <TextArea fx:id="postText" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                                  promptText="Введите сообщение!" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                            </HBox.margin>
                        </TextArea>
                        <Button fx:id="send" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                                mnemonicParsing="false" prefHeight="155.0" prefWidth="160.0" text="Отправить"
                                HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets bottom="10.0" right="10.0" top="10.0"/>
                            </HBox.margin>
                        </Button>
                    </children>
                </HBox>
            </children>
            <opaqueInsets>
                <Insets/>
            </opaqueInsets>
        </VBox>
    </children>
</HBox>
